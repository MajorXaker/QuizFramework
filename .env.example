# Server bind
QH_BIND_HOST=0.0.0.0
QH_BIND_PORT=8080

# Database — either supply DATABASE_URL or the QH_DB_* parts.
# DATABASE_URL=postgres://quiz:quiz@localhost:5432/quiz
QH_DB_HOST=localhost
QH_DB_PORT=5432
QH_DB_USER=quiz
QH_DB_PASSWORD=changeme
QH_DB_NAME=quiz

# Session lifecycle
# Hard cap on a single session's lifetime (default 6h).
QH_SESSION_TTL_SECONDS=21600
# How long after the host disconnects before the session is torn down.
QH_HOST_DISCONNECT_GRACE_SECONDS=60

# How the frontend reaches the backend. Leave empty to use same-origin.
# Set when hosting through Cloudflare tunnel / external DNS.
# QH_PUBLIC_BACKEND_URL=https://quiz.example.com

# Port published on the host by docker-compose (host -> container 8080).
QH_PUBLISH_PORT=8080

RUST_LOG=info
